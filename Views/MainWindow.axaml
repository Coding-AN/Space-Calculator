<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CalculatorGUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="CalculatorGUI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Name="View"
        Icon="/Assets/avalonia-logo.ico"
        Title="CalculatorGUI"
        >

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

        <Grid Name="Buttons" ColumnDefinitions="*, *, *, *" RowDefinitions="*,*, *, *, *, *">
            <TextBox x:Name="Result" Grid.Row="0" Grid.ColumnSpan="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" VerticalAlignment="Center"
            Text="{Binding Input}" FontSize="55"
            BorderThickness="0" BorderBrush="Transparent" Padding="0" CaretBrush="{Binding Background, ElementName=View}" FocusAdorner="{x:Null}"
            AttachedToVisualTree="Result_AttachedToVisualTree" LostFocus="Result_LostFocus" TextChanged="Result_TextChanged"/>
            <!--Add a converter to make the display's font size scale with the app size-->
            <Button x:Name="History" Grid.Row="1" Grid.Column="0" Classes="Number" Content="{Binding buttonContent}" Command="{Binding HistoryToggleCommand}" ZIndex="2" Background="{Binding historyBackground}"/>
            <Border x:Name="HistoryPanel" IsVisible="{Binding historyOut}" Background="Navy" Opacity="1.0" Margin="5" CornerRadius="15" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="{Binding HistoryDimension}" Grid.RowSpan="{Binding HistoryDimension}" ZIndex="1">
                <DockPanel>
                    <ScrollViewer HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <ItemsControl ItemsSource=""><!--Add an observable collection containing the history to this-->
                            <ItemsControl.ItemTemplate>
                                <DataTemplate ><!--Make the history list a viewmodel and bind it here as the datatype-->

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>


            <Button Grid.Row="1" Grid.Column="1" Classes="Number" Content="Backspace" Command="{Binding RemoveDigitCommand}"/>
            <Button Grid.Row="1" Grid.Column="2" Classes="Number" Content="Clear" Command="{Binding ClearInputCommand}"/>
            <Button Grid.Row="1" Grid.Column="3" Classes="Number" Content="(+/-)"/>

            <Button Grid.Row="2" Grid.Column="0" Classes="Number" Content="1" Command="{Binding AddDigitCommand}" CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}"/>
            <Button Grid.Row="2" Grid.Column="1" Classes="Number" Content="2" Command="{Binding AddDigitCommand}" CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}"/>
            <Button Grid.Row="2" Grid.Column="2" Classes="Number" Content="3" Command="{Binding AddDigitCommand}" CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}"/>
            <Button Grid.Row="3" Grid.Column="0" Classes="Number" Content="4" Command="{Binding AddDigitCommand}" CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}"/>
            <Button Grid.Row="3" Grid.Column="1" Classes="Number" Content="5" Command="{Binding AddDigitCommand}" CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}"/>
            <Button Grid.Row="3" Grid.Column="2" Classes="Number" Content="6" Command="{Binding AddDigitCommand}" CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}"/>
            <Button Grid.Row="4" Grid.Column="0" Classes="Number" Content="7" Command="{Binding AddDigitCommand}" CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}"/>
            <Button Grid.Row="4" Grid.Column="1" Classes="Number" Content="8" Command="{Binding AddDigitCommand}" CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}"/>
            <Button Grid.Row="4" Grid.Column="2" Classes="Number" Content="9" Command="{Binding AddDigitCommand}" CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}"/>
            <Button Grid.Row="5" Grid.Column="0" Classes="Number" Content="." Command="{Binding AddDigitCommand}" CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}"/>
            <Button Grid.Row="5" Grid.Column="1" Classes="Number" Content="0" Command="{Binding AddDigitCommand}" CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}"/>

            <Grid.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding CalculateCommand}"/>
                <KeyBinding Gesture="Back" Command="{Binding RemoveDigitCommand}"/>
                <KeyBinding Gesture="Delete" Command="{Binding ClearInputCommand}"/>
            </Grid.KeyBindings>

            <Button Grid.Row="5" Grid.Column="2" Classes="Number" Content="=" Command="{Binding CalculateCommand}"/>
            <Button Grid.Row="2" Grid.Column="3" Classes="Number" Content="+" Command="{Binding AddDigitCommand}" CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}"/>
            <Button Grid.Row="3" Grid.Column="3" Classes="Number" Content="-" Command="{Binding AddDigitCommand}" CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}"/>
            <Button Grid.Row="4" Grid.Column="3" Classes="Number" Content="×" Command="{Binding AddDigitCommand}" CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}"/>
            <Button Grid.Row="5" Grid.Column="3" Classes="Number" Content="÷" Command="{Binding AddDigitCommand}" CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}"/>
            

        </Grid>

</Window>
