<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CalculatorGUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="CalculatorGUI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Name="View"
        Icon="/Assets/avalonia-logo.ico"
        Title="CalculatorGUI">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

        <Grid ShowGridLines="True" Name="Buttons" ColumnDefinitions="*, *, *, *" RowDefinitions="*,*, *, *, *">
            <TextBox x:Name="Result" Grid.Row="0" Grid.ColumnSpan="4" FontSize="50"/>
            <!--Add a converter to make the display's font size scale with the app size-->
            <Button Grid.Row="1" Grid.Column="0" Classes="Number" Content="1"/>
            <Button Grid.Row="1" Grid.Column="1" Classes="Number" Content="2"/>
            <Button Grid.Row="1" Grid.Column="2" Classes="Number" Content="3"/>
            <Button Grid.Row="2" Grid.Column="0" Classes="Number" Content="4"/>
            <Button Grid.Row="2" Grid.Column="1" Classes="Number" Content="5"/>
            <Button Grid.Row="2" Grid.Column="2" Classes="Number" Content="6"/>
            <Button Grid.Row="3" Grid.Column="0" Classes="Number" Content="7"/>
            <Button Grid.Row="3" Grid.Column="1" Classes="Number" Content="8"/>
            <Button Grid.Row="3" Grid.Column="2" Classes="Number" Content="9"/>
            <Button Grid.Row="4" Grid.Column="0" Classes="Number" Content="."/>
            <Button Grid.Row="4" Grid.Column="1" Classes="Number" Content="0"/>
            <Button Grid.Row="4" Grid.Column="2" Classes="Number" Content="="/>
            <Button Grid.Row="1" Grid.Column="3" Classes="Number" Content="+"/>
            <Button Grid.Row="2" Grid.Column="3" Classes="Number" Content="-"/>
            <Button Grid.Row="3" Grid.Column="3" Classes="Number" Content="×"/>
            <Button Grid.Row="4" Grid.Column="3" Classes="Number" Content="÷"/>
            

        </Grid>

</Window>
